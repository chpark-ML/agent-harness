#!/usr/bin/env bash
# harnessctl — install the half of the harness that a plugin cannot carry.
#
#   harnessctl init      [--scope user|project] [--with dev,research] [--dry-run]
#   harnessctl doctor    [--scope user|project]
#   harnessctl uninstall [--scope user|project] [--purge-templates] [--dry-run]
#
# The plugin delivers hooks, skills, commands and verifiers; Claude Code loads
# those directly and this tool never touches them. What a plugin manifest
# cannot express is what remains here:
#
#   permissions allow/ask/deny   a plugin's settings.json supports only the
#   includeCoAuthoredBy          `agent` and `subagentStatusLine` keys
#   terminalProgressBarEnabled
#   CLAUDE.md                    a plugin-root CLAUDE.md is not loaded as context
#   .claude/rules/**             rules are not a plugin component, and are read
#                                from a project only
#   consumer-owned config        plugin files live in a cache that updates replace
#
# settings.json is parsed and re-serialised, never replaced, so keys already
# there survive. A timestamped snapshot is taken before the first write of a
# run, and .claude/harness-manifest.json records exactly what was added so
# uninstall can take back that and nothing else.
#
# Requires bash 3.2 (stock macOS) and jq.
set -uo pipefail

# jq on Windows writes CRLF, and `$(...)` strips the trailing newline but not
# the CR. Every path read back out of the manifest then carried a stray byte,
# so `[ -f "$p" ]` said the file it had just installed was missing and
# uninstall removed nothing -- `verify-install` caught it as 7 failures about
# files left behind. Normalised once here rather than at 37 call sites.
#
# PIPESTATUS keeps jq's own exit status, which matters here more than in the
# hooks: `jq -e` and `jq empty` are used for validity checks throughout.
#
# Defining this makes `command -v jq` answer "jq" -- the function -- whether or
# not the binary exists, so every jq guard in this file and in the hooks uses
# `type -P`, which only ever answers with a path. That is not a style choice:
# the preflight below sat dead behind `command -v` and a machine with no jq was
# told its settings.json was not a JSON object. `verify-install` asserts that no
# file defining this wrapper reaches for `command -v jq` again.
jq() { local rc; command jq "$@" | tr -d '\r'; rc=${PIPESTATUS[0]}; return "$rc"; }

CMD=""
SCOPE=project
WITH=""
WITH_SET=0
DRY_RUN=0
PURGE_TEMPLATES=0
SETTINGS_BACKUP=""

say()  { printf '%s\n' "$*"; }
warn() { printf '!  %s\n' "$*" >&2; }
die()  { printf '!  %s\n' "$*" >&2; exit 1; }

usage() {
  sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
}

[ $# -gt 0 ] || { usage; exit 1; }
case "$1" in
  init|doctor|uninstall) CMD="$1"; shift ;;
  -h|--help) usage; exit 0 ;;
  *) die "unknown command: $1  (init | doctor | uninstall)" ;;
esac

join_with() { # join two comma lists, dropping empties
  if [ -z "$1" ]; then printf '%s' "$2"
  elif [ -z "$2" ]; then printf '%s' "$1"
  else printf '%s,%s' "$1" "$2"; fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --scope)            shift; [ $# -gt 0 ] || die "--scope needs a value"; SCOPE="$1" ;;
    --scope=*)          SCOPE="${1#--scope=}" ;;
    # Repeating --with accumulates rather than overwriting. `--with dev --with
    # research` is a reasonable thing to type, and silently installing only the
    # last one loses a module the user explicitly asked for, with no warning.
    --with)             shift; [ $# -gt 0 ] || die "--with needs a value"; WITH="$(join_with "$WITH" "$1")"; WITH_SET=1 ;;
    --with=*)           WITH="$(join_with "$WITH" "${1#--with=}")"; WITH_SET=1 ;;
    --purge-templates)  PURGE_TEMPLATES=1 ;;
    --dry-run)          DRY_RUN=1 ;;
    -h|--help)          usage; exit 0 ;;
    *)                  die "unknown argument: $1" ;;
  esac
  shift
done

case "$SCOPE" in
  user|project) ;;
  local) die "--scope local is not supported yet. Targeting settings.local.json is backlog." ;;
  *) die "--scope takes user or project (got: $SCOPE)" ;;
esac

# ---- payload ----------------------------------------------------------------
# bin/harnessctl sits beside declarative/ inside the plugin, and the plugin cache
# is a faithful copy, so one relative resolution works both from the cache and
# from a source checkout. No $CLAUDE_PLUGIN_ROOT needed.
SELF="${BASH_SOURCE[0]:-}"
[ -n "$SELF" ] && [ -f "$SELF" ] || die "harnessctl must be run from a file; piping it in is not supported."
PLUGIN_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
PAYLOAD="$PLUGIN_ROOT/declarative"
[ -d "$PAYLOAD" ] || die "payload not found: $PAYLOAD"

validate_manifest() {
  [ -f "$MANIFEST" ] || return 0
  jq -e 'type == "object"' "$MANIFEST" >/dev/null 2>&1 && return 0
  die "cannot read $MANIFEST (not a valid JSON object).
   This file is committed, so a merge across branches can corrupt it.
   If losing the install record is acceptable, delete it and re-run:
     rm '$MANIFEST' && harnessctl init --scope $SCOPE"
}

type -P jq >/dev/null 2>&1 || die "jq is required.
   Install: brew install jq | apt-get install jq | dnf install jq | apk add jq"

if [ "$SCOPE" = user ]; then
  TARGET="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  SETTINGS="$TARGET/settings.json"
  MANIFEST="$TARGET/harness-manifest.json"
  CLAUDE_MD="$TARGET/CLAUDE.md"
  CONFIG_DIR="$TARGET"
  GITIGNORE=""
else
  TARGET="$PWD"
  SETTINGS="$TARGET/.claude/settings.json"
  MANIFEST="$TARGET/.claude/harness-manifest.json"
  CLAUDE_MD="$TARGET/CLAUDE.md"
  CONFIG_DIR="$TARGET/.claude"
  GITIGNORE="$TARGET/.gitignore"
fi

# The plugin half lives under the Claude config directory regardless of which
# scope harnessctl was asked about, and the shims live wherever install.sh put
# them. Neither is owned by the manifest; doctor only reports on them.
CLAUDE_CACHE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/cache"
SHIM_DIR="${BIN_DIR:-$HOME/.local/bin}"

# Installed harness plugins, one `name@marketplace:version` per line.
#
# Live means "not superseded", judged by the absence of `.orphaned_at`.
# `.in_use` is NOT a reliable signal — it was observed missing from the current
# version immediately after an update, so requiring it reports a plugin that is
# installed and working as absent. sort -V is what makes 1.10.0 outrank 1.9.0.
# sort -V is not everywhere: install.sh already treats it as optional (older
# BSD sorts lack it), and a doctor whose sort dies reports an installed,
# working plugin half as absent — the exact failure the .in_use trap taught.
# Lexicographic order is the degraded answer, wrong only across a digit-count
# boundary (1.9.0 vs 1.10.0), and reporting slightly-old beats reporting none.
sort_versions() {
  if printf 'x' | sort -V >/dev/null 2>&1; then sort -V; else sort; fi
}

installed_plugins() {
  local mkt pdir v mname pname ver
  for mkt in "$CLAUDE_CACHE"/*/; do
    [ -d "$mkt" ] || continue
    mname="$(basename "$mkt")"
    for pdir in "$mkt"*/; do
      [ -d "$pdir" ] || continue
      pname="$(basename "$pdir")"
      # Name AND marketplace, not name alone. A plugin that merely calls
      # itself harness-* in some unrelated marketplace must not be swept into
      # a list that ends in destructive uninstall suggestions.
      case "$pname@$mname" in
        harness-*@agent-harness) ;;
        superpowers@claude-plugins-official) ;;
        *) continue ;;
      esac
      ver="$(for v in "$pdir"*/; do
               [ -d "$v" ] || continue
               [ -f "$v/.orphaned_at" ] && continue
               basename "$v"
             done | sort_versions | tail -1)"
      [ -n "$ver" ] || continue
      printf '%s@%s:%s\n' "$pname" "$mname" "$ver"
    done
  done
}

GITIGNORE_WANT='.claude/settings.local.json
.claude/settings.json.bak-*'

TMP="$(mktemp -d)" || die "could not create a temp directory"
trap 'rm -rf "$TMP"' EXIT

# ---- doctor -----------------------------------------------------------------
if [ "$CMD" = doctor ]; then
  fail=0
  ok()   { say "  ok    $1"; }
  bad()  { warn "  FAIL  $1"; [ -n "${2:-}" ] && warn "        $2"; fail=1; }

  say "harnessctl doctor  (scope: $SCOPE, target: $TARGET)"
  say ""
  say "required tools:"
  # No `bad` branch: the preflight above refuses to reach any subcommand without
  # jq, so doctor cannot run and report it missing. It used to have one, and
  # that branch was reachable only because the preflight was dead — which is
  # exactly how doctor came to print `ok jq` with a blank version on a machine
  # that had none. `verify-install` pins the message a jq-less user now gets.
  ok "jq $(jq --version)"
  command -v git >/dev/null 2>&1 && ok "git $(git --version | awk '{print $3}')" || bad "git missing"

  say ""
  say "language servers (required by an installed language profile — the LSP plugins do not bundle a binary):"
  # binary:profile:how-to-install. Only the first two come from npm, which is
  # why --with-tools stops there and the rest are reported rather than fetched.
  for pair in "pyright-langserver:harness-python:npm install -g pyright" \
              "typescript-language-server:harness-typescript:npm install -g typescript-language-server typescript" \
              "csharp-ls:harness-csharp:dotnet tool install --global csharp-ls" \
              "clangd:harness-cpp:brew install llvm (macOS, then add its bin to PATH) or apt install clangd" \
              "lua-language-server:harness-lua:brew install lua-language-server" \
              "sourcekit-lsp:harness-swift:install Xcode, or brew install swift" \
              "kotlin-lsp:harness-kotlin:brew install JetBrains/utils/kotlin-lsp"; do
    binname="${pair%%:*}"; rest="${pair#*:}"; prof="${rest%%:*}"; how="${rest#*:}"
    if command -v "$binname" >/dev/null 2>&1; then
      ok "$binname ($prof)"
    else
      say "  --    $binname missing — if you use $prof: $how"
    fi
  done

  say ""
  say "external tools (required by a profile):"
  if command -v npx >/dev/null 2>&1 && npx --no-install slides-grab --version >/dev/null 2>&1; then
    ok "slides-grab (harness-slides)"
  elif [ -d node_modules/slides-grab ]; then
    ok "slides-grab (harness-slides, installed locally)"
  else
    say "  --    slides-grab missing — if you use harness-slides: npm install slides-grab && npx playwright install chromium"
  fi

  say ""
  say "install state:"
  if [ -f "$MANIFEST" ]; then
    jq empty "$MANIFEST" 2>/dev/null && ok "manifest valid (modules: $(jq -r '(.modules // []) | if length==0 then "core only" else join(", ") end' "$MANIFEST"))" \
      || bad "manifest is broken JSON" "$MANIFEST"
    manifest_ok=1
    jq -e 'type == "object"' "$MANIFEST" >/dev/null 2>&1 || manifest_ok=0
    missing=""
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      [ -e "$TARGET/$rel" ] || missing="$missing $rel"
    done < <(jq -r '((.files.managed // []) + (.files.template // []))[]' "$MANIFEST" 2>/dev/null)
    if [ "$manifest_ok" -eq 0 ]; then
      say "  --    file check skipped (manifest unreadable)"
    elif [ -z "$missing" ]; then ok "every file the manifest records exists"
    else bad "missing files" "$missing"; fi
  else
    say "  --    harnessctl init has not run (no manifest)"
  fi
  if [ -f "$SETTINGS" ]; then
    jq empty "$SETTINGS" 2>/dev/null && ok "settings.json is valid JSON" || bad "settings.json is broken JSON" "$SETTINGS"
  else
    say "  --    no settings.json"
  fi

  say ""
  say "guards (registered by the plugin — run here directly to confirm):"
  hook="$PLUGIN_ROOT/hooks/secret-scrubber.sh"
  if [ -f "$hook" ]; then
    printf '%s' '{"tool_name":"Bash","tool_input":{"command":"export AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE"}}' | bash "$hook" >/dev/null 2>&1
    [ $? -eq 2 ] && ok "secret-scrubber blocks a literal key" || bad "secret-scrubber did not block"
    printf '%s' '{"tool_name":"Bash","tool_input":{"command":"git status"}}' | bash "$hook" >/dev/null 2>&1
    [ $? -eq 0 ] && ok "secret-scrubber passes an ordinary command" || bad "secret-scrubber blocked an ordinary command"
  else
    bad "hook not found" "$hook"
  fi
  if [ -f "$CONFIG_DIR/protected-paths.txt" ] \
     && ! grep -q '^[[:space:]]*[^[:space:]#]' "$CONFIG_DIR/protected-paths.txt" 2>/dev/null; then
    say "  --    protected-paths inactive — list absolute path prefixes in $CONFIG_DIR/protected-paths.txt to turn it on"
  fi
  if [ -f "$CONFIG_DIR/gh-account.txt" ] \
     && ! grep -q '^[[:space:]]*[^[:space:]#]' "$CONFIG_DIR/gh-account.txt" 2>/dev/null; then
    say "  --    gh-account-guard inactive — put the expected account login in $CONFIG_DIR/gh-account.txt to turn it on"
  fi

  # The plugin half, which this tool installs nothing of and therefore removes
  # nothing of. Uninstall used to name harness-core alone while a default
  # install places four, so following the printed instruction left the rest
  # behind. Reading the cache is the only way to say what is actually there:
  # asking `claude` would be a second dependency for a report, and hardcoding
  # the list would go stale the moment a profile is added.
  say ""
  say "plugins (installed by Claude Code — harnessctl neither installs nor removes these):"
  plugin_specs=""
  for line in $(installed_plugins); do
    say "  ok    ${line%%:*}  ${line##*:}"
    plugin_specs="$plugin_specs ${line%%:*}"
  done
  if [ -z "$plugin_specs" ]; then
    say "  --    none found under $CLAUDE_CACHE — the guards and skills come from these, so an empty list means only the declarative half is installed"
  else
    say ""
    say "  to remove the plugin half:"
    for spec in $plugin_specs; do
      say "    claude plugin uninstall $spec --prune"
    done
  fi

  # Config that claims a plugin is on while nothing can load it. Claude Code
  # records enabledPlugins as "<name>@<marketplace>"; if the marketplace was
  # removed or the plugin never cached, the entry stays and no error is ever
  # printed — behaviourless config, and the reason a machine drifts without
  # anyone noticing. A dangling entry is a FAIL because something is claimed
  # and absent.
  #
  # A marketplace nobody uses is NOT a failure and is reported as a note. It is
  # harmless (registering one is how you browse), and a doctor that raises
  # alarms over harmless state is a doctor people stop reading.
  USER_SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
  if [ -f "$USER_SETTINGS" ] && jq empty "$USER_SETTINGS" 2>/dev/null; then
    dangling=""
    for spec in $(jq -r '(.enabledPlugins // {}) | keys[]' "$USER_SETTINGS" 2>/dev/null); do
      pname="${spec%%@*}"; mname="${spec##*@}"
      resolved=""
      for v in "$CLAUDE_CACHE/$mname/$pname"/*/; do
        [ -d "$v" ] || continue
        [ -f "$v/.orphaned_at" ] && continue
        resolved=1
      done
      [ -n "$resolved" ] || dangling="$dangling $spec"
    done
    if [ -n "$dangling" ]; then
      say ""
      for spec in $dangling; do
        bad "enabled but not installed: $spec" \
            "settings.json turns it on and nothing under $CLAUDE_CACHE can load it — remove the entry, or reinstall the plugin"
      done
    fi

    unused=""
    for mkt in "$CLAUDE_CACHE"/../marketplaces/*/; do
      [ -d "$mkt" ] || continue
      mname="$(basename "$mkt")"
      jq -r '(.enabledPlugins // {}) | keys[]' "$USER_SETTINGS" 2>/dev/null \
        | grep -q "@$mname\$" || unused="$unused $mname"
    done
    if [ -n "$unused" ]; then
      say ""
      say "  note  registered marketplaces no enabled plugin uses:$unused"
      say "        harmless — remove with: claude plugin marketplace remove <name>"
    fi
  fi

  # What the whole room costs — not only our share. context-budget.sh gates a
  # CI ceiling on what this harness ships, and that is the right scope for a
  # gate: a consumer's third-party installs must not turn our CI red. But a
  # session pays for every enabled plugin, whoever shipped it — measured
  # 2026-08-13, two third-party installs pushed a session past the ceiling
  # while the gate printed green (harness-gaps.md, same date). So doctor,
  # which runs on the machine where the truth lives, reports the composite
  # informationally and fails nothing. `claude plugin details` is the same
  # instrument the SOT's cost table uses, so the numbers are comparable; the
  # CLI is also what installed whatever the cache holds, so asking for it here
  # asks for nothing the machine does not already have — still, degrade to a
  # note rather than fail when it is absent.
  say ""
  say "always-on context (every enabled plugin — the CI ceiling gates only this harness's share):"
  if [ -f "$USER_SETTINGS" ] && jq empty "$USER_SETTINGS" 2>/dev/null; then
    if command -v claude >/dev/null 2>&1; then
      comp_total=0; comp_unmeasured=""; comp_any=0
      for spec in $(jq -r '(.enabledPlugins // {}) | to_entries[] | select(.value == true) | .key' "$USER_SETTINGS" 2>/dev/null); do
        comp_any=1
        tok="$(claude plugin details "$spec" 2>/dev/null | tr -d '\r' \
               | sed -n 's/.*Always-on:[[:space:]]*~\{0,1\}\([0-9,][0-9,]*\)[[:space:]]*tok.*/\1/p' \
               | head -1 | tr -d ',')"
        case "$tok" in
          ''|*[!0-9]*) comp_unmeasured="$comp_unmeasured $spec" ;;
          *) say "  ok    $spec  ~$tok tok"
             comp_total=$((comp_total + tok)) ;;
        esac
      done
      if [ "$comp_any" -eq 0 ]; then
        say "  --    no enabled plugins recorded in $USER_SETTINGS"
      else
        say "        total ~$comp_total tok added to every session on this machine"
        [ -n "$comp_unmeasured" ] && say "  --    no Always-on figure from claude plugin details:$comp_unmeasured"
      fi
    else
      say "  --    skipped — claude CLI not on PATH (it is the cost table's instrument)"
    fi
  else
    say "  --    skipped — no readable settings.json at $USER_SETTINGS"
  fi

  # The shims are written by install.sh, not by harnessctl, so uninstall does
  # not take them back either. They are harmless once the plugin is gone (each
  # prints an install hint and exits 1), but a complete removal includes them.
  shim_list=""
  for s in "$SHIM_DIR"/*; do
    [ -f "$s" ] || continue
    grep -q 'shim — resolves the installed plugin at run time' "$s" 2>/dev/null || continue
    shim_list="$shim_list $s"
  done
  if [ -n "$shim_list" ]; then
    say ""
    say "  shell shims (written by install.sh):"
    for s in $shim_list; do say "    $s"; done
    say "    remove with:  rm$shim_list"
  fi

  say ""
  [ "$fail" -eq 0 ] && say "no problems found." || warn "look at the FAIL entries above."
  exit "$fail"
fi

validate_manifest

# ---- shared: file plan ------------------------------------------------------
# Payload path → target-relative path. Rules only exist in a project: there is
# no documented ~/.claude/rules, so installing them at user scope would place
# inert files where they look active.
MODULES=""
if [ "$WITH_SET" -eq 1 ]; then
  MODULES="$(printf '%s' "$WITH" | tr ',' ' ' | tr -s ' ' | LC_ALL=C tr ' ' '\n' | grep -v '^$' | LC_ALL=C sort -u | tr '\n' ' ')"
elif [ -f "$MANIFEST" ]; then
  MODULES="$(jq -r '(.modules // []) | sort | join(" ")' "$MANIFEST" 2>/dev/null)"
fi
for m in $MODULES; do
  [ -d "$PAYLOAD/rules/$m" ] || die "no such module '$m'. Available: $(ls "$PAYLOAD/rules" 2>/dev/null | grep -v '^core$' | tr '\n' ' ')"
done

PLAN_MANAGED=""
PLAN_TEMPLATE=""
PLAN_SKIPPED=""
add() { PLAN_MANAGED="${PLAN_MANAGED}$1	$2
"; }
addt() { PLAN_TEMPLATE="${PLAN_TEMPLATE}$1	$2
"; }

addt "$PAYLOAD/CLAUDE.md" "CLAUDE.md"
if [ "$SCOPE" = user ]; then
  addt "$PAYLOAD/templates/protected-paths.txt" "protected-paths.txt"
  addt "$PAYLOAD/templates/allowed-paths.txt"   "allowed-paths.txt"
  addt "$PAYLOAD/templates/gh-account.txt"      "gh-account.txt"
  PLAN_SKIPPED="rules/ (path-scoped rules are only read in a project)"
else
  addt "$PAYLOAD/templates/protected-paths.txt" ".claude/protected-paths.txt"
  addt "$PAYLOAD/templates/allowed-paths.txt"   ".claude/allowed-paths.txt"
  addt "$PAYLOAD/templates/gh-account.txt"      ".claude/gh-account.txt"
  add "$PAYLOAD/rules/core/workflow.md" ".claude/rules/harness/workflow.md"
  for m in $MODULES; do
    for src in "$PAYLOAD/rules/$m"/*.md; do
      [ -f "$src" ] || continue
      add "$src" ".claude/rules/harness/$m/$(basename "$src")"
    done
  done
fi

NEW_MANAGED="$(printf '%s' "$PLAN_MANAGED" | cut -f2 | grep -v '^$' | LC_ALL=C sort)"
NEW_TEMPLATE="$(printf '%s' "$PLAN_TEMPLATE" | cut -f2 | grep -v '^$' | LC_ALL=C sort)"

# ---- jq programs ------------------------------------------------------------
# No hook handling: the plugin owns hooks now, so settings.json only carries
# permissions and scalars, and those are tracked by exact string in the manifest.
JQ_ADDITIONS='
def add_for($tier): (($frag.permissions[$tier] // []) - (.permissions[$tier] // []));
. as $base
| { allow: add_for("allow"), ask: add_for("ask"), deny: add_for("deny") } as $padd
| (($frag.scalars // {}) | to_entries | map(select(. as $e | ($base | has($e.key)) | not)) | from_entries) as $sadd
| {
    permissions_added: $padd,
    scalars_added: $sadd,
    created_paths: (
      (if ((($base | has("permissions")) | not)
           and (([$padd.allow, $padd.ask, $padd.deny] | map(length) | add) > 0))
       then [["permissions"]] else [] end)
      + (["allow","ask","deny"]
         | map(select(. as $t
                | (($padd[$t] | length) > 0)
                  and ((($base.permissions // {}) | has($t)) | not)))
         | map(["permissions", .]))
    )
  }
'

JQ_APPLY='
reduce ($addscalars | to_entries[]) as $e (.; .[$e.key] = $e.value)
| reduce ($addperm | to_entries[]) as $e (.;
    if (($e.value | length) > 0)
    then .permissions[$e.key] = ((.permissions[$e.key] // []) + $e.value)
    else . end)
'

JQ_REVERT='
reduce ($rmperm | to_entries[]) as $e (.;
    if ((.permissions // null) != null and ((.permissions[$e.key] // null) != null))
    then .permissions[$e.key] = (.permissions[$e.key] - $e.value)
    else . end)
| reduce ($rmscalars | to_entries[]) as $e (.;
    if (.[$e.key] == $e.value) then del(.[$e.key]) else . end)
| reduce ($created | sort_by(length) | reverse | .[]) as $p (.;
    if (((getpath($p) | type) | (. == "object" or . == "array"))
        and ((getpath($p) | length) == 0))
    then delpaths([$p]) else . end)
'

# ---- write helpers ----------------------------------------------------------
lines_to_json() { jq -Rs 'split("\n") | map(select(length > 0))'; }

install_one() {
  local src="$1" rel="$2" dst="$TARGET/$2"
  if [ -e "$dst" ] && cmp -s "$src" "$dst"; then say "  =  $rel"; return 0; fi
  if [ -e "$dst" ]; then say "  ↻  $rel  (overwritten)"; else say "  +  $rel"; fi
  [ "$DRY_RUN" -eq 1 ] && return 0
  mkdir -p "$(dirname "$dst")" || die "could not create directory: $rel"
  cp "$src" "$dst" || die "could not copy: $rel"
  return 0
}
install_template() {
  local src="$1" rel="$2" dst="$TARGET/$2"
  if [ -e "$dst" ]; then say "  =  $rel  (kept as it was — template)"; return 0; fi
  say "  +  $rel  (template)"
  [ "$DRY_RUN" -eq 1 ] && return 0
  mkdir -p "$(dirname "$dst")" || die "could not create directory: $rel"
  cp "$src" "$dst" || die "could not copy: $rel"
}
remove_file() {
  local rel="$1" dst="$TARGET/$1"
  [ -e "$dst" ] || return 0
  say "  -  $rel"
  [ "$DRY_RUN" -eq 1 ] && return 0
  rm -f "$dst"
}
prune_dirs_for() {
  local rel d
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    d="$(dirname "$rel")"
    while [ "$d" != "." ] && [ "$d" != "/" ]; do printf '%s\n' "$d"; d="$(dirname "$d")"; done
  done | LC_ALL=C sort -ru | while IFS= read -r d; do
    [ -d "$TARGET/$d" ] || continue
    [ "$DRY_RUN" -eq 1 ] && continue
    rmdir "$TARGET/$d" 2>/dev/null && say "  -  $d/"
  done
  return 0
}
snapshot_settings() {
  [ "$DRY_RUN" -eq 1 ] && return 0
  [ -n "$SETTINGS_BACKUP" ] && return 0
  [ -f "$SETTINGS" ] || return 0
  local stamp backup n
  stamp="$(date +%Y%m%d-%H%M%S)"; backup="$SETTINGS.bak-$stamp"; n=1
  while [ -e "$backup" ]; do backup="$SETTINGS.bak-$stamp-$n"; n=$((n + 1)); done
  cp "$SETTINGS" "$backup" || die "could not back up settings"
  SETTINGS_BACKUP="$backup"
}
GITIGNORE_ADDED=""
GITIGNORE_CREATED=0
ensure_gitignore_line() {
  local line="$1"
  if [ -f "$GITIGNORE" ] && grep -qxF "$line" "$GITIGNORE"; then say "  =  .gitignore  ($line)"; return 0; fi
  say "  +  .gitignore  ($line)"
  GITIGNORE_ADDED="${GITIGNORE_ADDED}${line}
"
  [ "$DRY_RUN" -eq 1 ] && return 0
  if [ ! -f "$GITIGNORE" ]; then printf '%s\n' "$line" > "$GITIGNORE"; GITIGNORE_CREATED=1; return 0; fi
  [ -n "$(tail -c1 "$GITIGNORE" 2>/dev/null)" ] && printf '\n' >> "$GITIGNORE"
  printf '%s\n' "$line" >> "$GITIGNORE"
}
remove_gitignore_line() {
  local line="$1"
  [ -f "$GITIGNORE" ] || return 0
  grep -qxF "$line" "$GITIGNORE" || return 0
  say "  -  .gitignore  ($line)"
  [ "$DRY_RUN" -eq 1 ] && return 0
  grep -vxF "$line" "$GITIGNORE" > "$TMP/gi"; mv "$TMP/gi" "$GITIGNORE"
}

# ---- uninstall --------------------------------------------------------------
if [ "$CMD" = uninstall ]; then
  [ -f "$MANIFEST" ] || die "no $MANIFEST — there is no install record to remove."
  old_managed="$(jq -r '(.files.managed // [])[]' "$MANIFEST")"
  old_template="$(jq -r '(.files.template // [])[]' "$MANIFEST")"
  old_gitignore="$(jq -r '(.gitignore_added // [])[]' "$MANIFEST")"
  old_gi_created="$(jq -r '.gitignore_created // false' "$MANIFEST")"
  old_settings_created="$(jq -r '.settings.file_created // false' "$MANIFEST")"
  rm_perm="$(jq -c '.settings.permissions_added // {}' "$MANIFEST")"
  rm_scalars="$(jq -c '.settings.scalars_added // {}' "$MANIFEST")"
  rm_created="$(jq -c '.settings.created_paths // []' "$MANIFEST")"

  say "harnessctl uninstall  (scope: $SCOPE, target: $TARGET)"
  [ "$DRY_RUN" -eq 1 ] && say "  (dry-run — nothing is written)"
  say ""
  say "settings:"
  if [ -f "$SETTINGS" ]; then
    snapshot_settings
    jq --argjson rmperm "$rm_perm" --argjson rmscalars "$rm_scalars" --argjson created "$rm_created" \
      "$JQ_REVERT" "$SETTINGS" > "$TMP/s.json" || die "could not revert settings"
    if [ "$(jq -c '.' "$TMP/s.json")" = "{}" ] && [ "$old_settings_created" = "true" ]; then
      say "  -  ${SETTINGS#"$TARGET"/}  (created by the installer, now empty — deleted)"
      [ "$DRY_RUN" -eq 1 ] || rm -f "$SETTINGS" || die "could not delete settings — the manifest is left alone, so fix the cause and re-run: $SETTINGS"
    else
      say "  ↻  ${SETTINGS#"$TARGET"/}  (recorded permissions and scalars removed)"
      # Must not continue past this: the manifest is the only record of which
      # permission strings are ours, and it is deleted a few steps below.
      [ "$DRY_RUN" -eq 1 ] || mv "$TMP/s.json" "$SETTINGS" || die "could not write settings — the manifest is left alone, so fix the cause and re-run: $SETTINGS"
    fi
  else
    say "  =  no settings file"
  fi

  say ""
  say "files:"
  printf '%s\n' "$old_managed" | while IFS= read -r r; do [ -n "$r" ] && remove_file "$r"; done
  if [ "$PURGE_TEMPLATES" -eq 1 ]; then
    printf '%s\n' "$old_template" | while IFS= read -r r; do [ -n "$r" ] && remove_file "$r"; done
  elif [ -n "$old_template" ]; then
    say "  (templates kept — use --purge-templates to remove them)"
  fi

  if [ -n "$GITIGNORE" ]; then
    say ""
    say ".gitignore:"
    while IFS= read -r l; do [ -n "$l" ] && remove_gitignore_line "$l"; done <<EOF
$old_gitignore
EOF
    if [ "$old_gi_created" = "true" ] && [ -f "$GITIGNORE" ] && [ ! -s "$GITIGNORE" ]; then
      say "  -  .gitignore  (created by the installer, now empty — deleted)"
      [ "$DRY_RUN" -eq 1 ] || rm -f "$GITIGNORE"
    fi
  fi

  say ""
  say "manifest:"
  remove_file "${MANIFEST#"$TARGET"/}"
  { printf '%s\n' "$old_managed"
    [ "$PURGE_TEMPLATES" -eq 1 ] && printf '%s\n' "$old_template"
    printf '%s\n' "${MANIFEST#"$TARGET"/}"
  } | prune_dirs_for

  say ""
  if [ "$DRY_RUN" -eq 1 ]; then
    say "dry-run finished — nothing changed."
  else
    say "removed. The plugins are untouched — to remove those too:"
    # Naming harness-core alone was wrong: a default install places four, so
    # following that line left the rest behind. List what is actually there.
    uninst_any=0
    for line in $(installed_plugins); do
      say "  claude plugin uninstall ${line%%:*} --prune"
      uninst_any=1
    done
    [ "$uninst_any" -eq 0 ] && say "  (none found — the plugin half is already gone)"
    [ -n "$SETTINGS_BACKUP" ] && say "  snapshot taken just before removal: $SETTINGS_BACKUP"
  fi
  exit 0
fi

# ---- init -------------------------------------------------------------------
say "harnessctl init  (scope: $SCOPE, target: $TARGET)"
say "  modules: core${MODULES:+ + $(printf '%s' "$MODULES" | tr -s ' ' | sed 's/ *$//; s/ /, /g')}"
[ "$DRY_RUN" -eq 1 ] && say "  (dry-run — nothing is written)"

if [ "$SCOPE" = project ] && [ ! -e "$TARGET/.git" ]; then
  die "no .git in the current directory. Run this from the project root, or use --scope user."
fi
if [ -f "$SETTINGS" ]; then
  [ -r "$SETTINGS" ] || die "cannot read $SETTINGS (check the permissions)."
  jq -e 'type == "object"' "$SETTINGS" >/dev/null 2>&1 \
    || die "$SETTINGS is not a JSON object (arrays, scalars and null cannot be merged into)."
fi

OWNED=""
[ -f "$MANIFEST" ] && OWNED="$(jq -r '((.files.managed // []) + (.files.template // []))[]' "$MANIFEST")"
conflicts=""
while IFS="$(printf '\t')" read -r src rel; do
  [ -n "$rel" ] || continue
  [ -e "$TARGET/$rel" ] || continue
  cmp -s "$src" "$TARGET/$rel" && continue
  printf '%s\n' "$OWNED" | grep -qxF "$rel" && continue
  conflicts="${conflicts}  $rel
"
done <<EOF
$PLAN_MANAGED
EOF
[ -z "$conflicts" ] || die "these paths hold files the harness does not own — stopping before writing anything:
$conflicts
   Move or delete them, or re-run with a scope that does not target them.
   The harness only overwrites files its own manifest records."

say ""
say "files (managed):"
while IFS="$(printf '\t')" read -r src rel; do
  [ -n "$rel" ] && install_one "$src" "$rel"
done <<EOF
$PLAN_MANAGED
EOF
say ""
say "files (template):"
while IFS="$(printf '\t')" read -r src rel; do
  [ -n "$rel" ] && install_template "$src" "$rel"
done <<EOF
$PLAN_TEMPLATE
EOF
[ -n "$PLAN_SKIPPED" ] && { say ""; say "excluded in this scope: $PLAN_SKIPPED"; }

if [ -n "$OWNED" ]; then
  stale="$(printf '%s\n' "$OWNED" | grep -v '^$' | LC_ALL=C sort \
           | comm -23 - <(printf '%s\n%s\n' "$NEW_MANAGED" "$NEW_TEMPLATE" | grep -v '^$' | LC_ALL=C sort -u))"
  if [ -n "$stale" ]; then
    say ""
    say "files (not in this selection — removed):"
    printf '%s\n' "$stale" | while IFS= read -r r; do [ -n "$r" ] && remove_file "$r"; done
    printf '%s\n' "$stale" | prune_dirs_for
  fi
fi

# Provisional manifest: the files are on disk now, so uninstall must be able to
# find them even if a later step dies.
MANIFEST_BEFORE=""
[ -f "$MANIFEST" ] && MANIFEST_BEFORE="$(cat "$MANIFEST")"
if [ "$DRY_RUN" -eq 0 ] && [ -z "$MANIFEST_BEFORE" ]; then
  mkdir -p "$(dirname "$MANIFEST")"
  jq -n --arg scope "$SCOPE" \
    --argjson managed "$(printf '%s\n' "$NEW_MANAGED" | lines_to_json)" \
    --argjson template "$(printf '%s\n' "$NEW_TEMPLATE" | lines_to_json)" \
    '{harness:"agent-harness", scope:$scope, modules:[],
      files:{managed:$managed, template:$template},
      settings:{permissions_added:{}, scalars_added:{}, created_paths:[], file_created:false},
      gitignore_added:[], gitignore_created:false, incomplete:true}' > "$MANIFEST" \
    || die "could not write the draft manifest"
fi

FRAG="$(cat "$PAYLOAD/settings-fragment.json")"
if [ -f "$SETTINGS" ]; then cp "$SETTINGS" "$TMP/base.json"; else printf '{}\n' > "$TMP/base.json"; fi
SETTINGS_FILE_CREATED=false
[ -f "$SETTINGS" ] || SETTINGS_FILE_CREATED=true
if [ -n "$MANIFEST_BEFORE" ]; then
  jq --argjson rmperm "$(jq -c '.settings.permissions_added // {}' "$MANIFEST")" \
     --argjson rmscalars "$(jq -c '.settings.scalars_added // {}' "$MANIFEST")" \
     --argjson created "$(jq -c '.settings.created_paths // []' "$MANIFEST")" \
     "$JQ_REVERT" "$TMP/base.json" > "$TMP/base2.json" || die "could not revert the previous install"
  mv "$TMP/base2.json" "$TMP/base.json"
  [ "$(jq -r '.settings.file_created // false' "$MANIFEST")" = "true" ] && SETTINGS_FILE_CREATED=true
fi
ADDITIONS="$(jq -c --argjson frag "$FRAG" "$JQ_ADDITIONS" "$TMP/base.json")" || die "could not compute the additions"

# Documented behaviour: a scalar the consumer already set is left alone. Saying
# so matters most for includeCoAuthoredBy — leaving it true silently defeats the
# guard the harness exists to provide.
while IFS= read -r k; do
  [ -n "$k" ] || continue
  warn "$k is already set to $(jq -c --arg k "$k" '.[$k]' "$TMP/base.json") and is left alone (the harness would suggest $(printf '%s' "$FRAG" | jq -c --arg k "$k" '.scalars[$k]'))."
done < <(printf '%s' "$FRAG" | jq -r --slurpfile base "$TMP/base.json" \
  '(.scalars // {}) | to_entries[] | . as $e
   | select(($base[0] | has($e.key)) and ($base[0][$e.key] != $e.value)) | $e.key')
jq --argjson addperm "$(printf '%s' "$ADDITIONS" | jq -c '.permissions_added')" \
   --argjson addscalars "$(printf '%s' "$ADDITIONS" | jq -c '.scalars_added')" \
   "$JQ_APPLY" "$TMP/base.json" > "$TMP/settings.json" || die "could not merge settings"

say ""
say "settings (${SETTINGS#"$TARGET"/} — re-serialised after parsing, existing keys preserved):"
if [ -f "$SETTINGS" ] && cmp -s "$TMP/settings.json" "$SETTINGS"; then
  say "  =  no change"
else
  added_any="$(printf '%s' "$ADDITIONS" | jq -r '((.permissions_added | to_entries | map(.value | length) | add) + (.scalars_added | length)) > 0')"
  if [ "$added_any" = "true" ]; then
    printf '%s' "$ADDITIONS" | jq -r '
      (.permissions_added | to_entries[] | select((.value | length) > 0)
        | "  +  permissions." + .key + ": " + ((.value | length) | tostring) + " entries"),
      (.scalars_added | to_entries[] | "  +  " + .key + " = " + (.value | tostring))'
  else
    say "  ↻  no content change — re-serialised only"
  fi
  if [ "$DRY_RUN" -eq 0 ]; then
    snapshot_settings
    mkdir -p "$(dirname "$SETTINGS")"
    mv "$TMP/settings.json" "$SETTINGS" || die "could not write settings"
  fi
fi

if [ -n "$GITIGNORE" ]; then
  say ""
  say ".gitignore:"
  while IFS= read -r l; do [ -n "$l" ] && ensure_gitignore_line "$l"; done <<EOF
$GITIGNORE_WANT
EOF
fi

if [ "$DRY_RUN" -eq 0 ]; then
  jq -n \
    --argjson modules "$(for m in $MODULES; do printf '%s\n' "$m"; done | lines_to_json)" \
    --arg scope "$SCOPE" \
    --argjson managed "$(printf '%s\n' "$NEW_MANAGED" | lines_to_json)" \
    --argjson template "$(printf '%s\n' "$NEW_TEMPLATE" | lines_to_json)" \
    --argjson additions "$ADDITIONS" \
    --argjson file_created "$SETTINGS_FILE_CREATED" \
    --argjson gitignore_added "$(printf '%s' "$GITIGNORE_ADDED" | lines_to_json)" \
    --argjson gitignore_created "$([ "$GITIGNORE_CREATED" -eq 1 ] && echo true || echo false)" \
    '{ harness: "agent-harness", scope: $scope, modules: $modules,
       files: { managed: $managed, template: $template },
       settings: { permissions_added: $additions.permissions_added,
                   scalars_added: $additions.scalars_added,
                   created_paths: $additions.created_paths,
                   file_created: $file_created },
       gitignore_added: ($gitignore_added | unique),
       gitignore_created: $gitignore_created }' > "$TMP/m.json" || die "could not build the manifest"
  if [ -n "$MANIFEST_BEFORE" ]; then
    printf '%s' "$MANIFEST_BEFORE" > "$TMP/mold.json"
    jq -s '.[0] as $o | .[1]
           | .gitignore_added = ((($o.gitignore_added // []) + .gitignore_added) | unique)
           | .gitignore_created = (($o.gitignore_created // false) or .gitignore_created)' \
      "$TMP/mold.json" "$TMP/m.json" > "$TMP/m2.json" && mv "$TMP/m2.json" "$TMP/m.json"
  fi
  say ""
  say "manifest:"
  if [ -n "$MANIFEST_BEFORE" ] && [ "$MANIFEST_BEFORE" = "$(cat "$TMP/m.json")" ]; then
    say "  =  ${MANIFEST#"$TARGET"/}"
  else
    [ -n "$MANIFEST_BEFORE" ] && say "  ↻  ${MANIFEST#"$TARGET"/}" || say "  +  ${MANIFEST#"$TARGET"/}"
    mkdir -p "$(dirname "$MANIFEST")"
    mv "$TMP/m.json" "$MANIFEST" || die "could not write the manifest"
  fi
fi

say ""
if [ "$DRY_RUN" -eq 1 ]; then
  say "dry-run finished — nothing changed."
else
  say "done. Next:"
  say "  - check:   harnessctl doctor --scope $SCOPE"
  [ "$SCOPE" = project ] && say "  - review:  git status && git diff"
  [ -n "$SETTINGS_BACKUP" ] && say "  - snapshot just before: $SETTINGS_BACKUP"
fi
exit 0
