        "Bash(rg:*)",
        "Bash(sort:*)",
        "Bash(uniq:*)",
        "Bash(diff:*)",
        "Bash(jq:*)",
        "Bash(mkdir:*)",
        "Bash(touch:*)",
        "Bash(cp:*)",
        "Bash(mv:*)",
        "Bash(make:*)",
        "Bash(pytest:*)",
